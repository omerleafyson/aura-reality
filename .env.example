# Public Firebase web configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Server-side Firebase Admin / Cloud Run configuration
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)

# Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
# Optional comma-separated fallbacks. Current safe defaults are used when omitted.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Usage limits
ANON_GENERATION_LIMIT=2
FREE_GENERATION_LIMIT=5
PRO_GENERATION_LIMIT=100

# Application origin used for billing redirects
APP_URL=

# Stripe (optional — leave empty to keep billing disabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
PRO_PRICE_DISPLAY=
